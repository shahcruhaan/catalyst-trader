# ============================================================
# AI Catalyst Momentum Breakout Paper Trader
# Environment Variables Template
# ============================================================
#
# INSTRUCTIONS:
# 1. Copy this file and rename the copy to exactly:  .env
# 2. Replace the placeholder values below with your real keys.
# 3. NEVER share your .env file. NEVER upload it to GitHub.
#    The real .env file is intentionally excluded from version
#    control by .gitignore so your keys stay private.
#
# HOW TO GET YOUR ALPACA PAPER TRADING API KEYS:
# Step 1: Go to https://alpaca.markets and create a free account.
# Step 2: Log in to the Alpaca dashboard.
# Step 3: In the top-left corner, make sure you are in
#          "Paper Trading" mode (NOT "Live Trading").
# Step 4: Click "Your API Keys" or go to the API section.
# Step 5: Click "Generate New Key" and copy both keys.
# Step 6: Paste them below between the quotes.
#
# IMPORTANT: ALPACA_PAPER must always be set to true.
# If it is not true, this bot will refuse to run.
# ============================================================

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_PAPER=true

# ============================================================
# Email Alerts (optional but strongly recommended for server deployment)
# ============================================================
# The bot sends emails when: a trade is placed, trading is paused,
# a critical error occurs, or the daily report is ready.
#
# HOW TO SET UP (Gmail only):
#   1. Enable 2-Factor Authentication on your Google account.
#   2. Go to: myaccount.google.com/apppasswords
#   3. Create a new App Password for "Mail" — you get a 16-character code.
#   4. Paste it into ALERT_EMAIL_PASSWORD below (spaces are fine).
#   5. ALERT_EMAIL_FROM and ALERT_EMAIL_TO can be the same Gmail address.
#
# Leave blank to disable email alerts (bot still runs fine without them).
# ============================================================
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=

# ============================================================
# LLM Catalyst Scoring (optional — free heuristic mode works without these)
# ============================================================
# If set, the bot can use an AI language model to score news headlines
# for ambiguous stocks (those with heuristic scores 5–8).
# Only used when catalyst_scoring.use_llm_if_available is true in config.yaml.
#
# OPENAI (PRIMARY — GPT-4o-mini, ~$0.01–0.05/day typical usage)
#   1. Go to platform.openai.com and create an account.
#   2. Click "API Keys" and generate a new secret key.
#   3. Paste it below.
#
# ANTHROPIC (FALLBACK — Claude Haiku, used only if OpenAI key is absent)
#   1. Go to console.anthropic.com and create an account.
#   2. Click "API Keys" and generate a new key.
#   3. Paste it below.
#
# Leave both blank to use heuristic scoring only (no cost, no API key needed).
# ============================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
